#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Salidas de flutter analyze/test que genera el script de migración
registros_locales/

# Scripts de ayuda que solo sirven en la PC de desarrollo (p. ej. preparar el emulador)
herramientas_locales/

# La base de contenido (assets/db/contenido.db) SÍ se sube al repo, para que
# la app compile sin tener Python. Se regenera con herramientas_datos/construir_db.py.
assets/db/*.tmp
